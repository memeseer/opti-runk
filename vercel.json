{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix leaderboard ci",
  "buildCommand": "npm --prefix leaderboard run build",
  "outputDirectory": "leaderboard/dist/client",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

